# Server
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=redovisning
DB_USER=postgres
DB_PASSWORD=postgres

# MongoDB
MONGO_URL=mongodb://localhost:27017/redovisning

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# AI APIs
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@redovisning.se

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Tink Open Banking API
TINK_CLIENT_ID=your-tink-client-id
TINK_CLIENT_SECRET=your-tink-client-secret
TINK_API_URL=https://api.tink.com
TINK_REDIRECT_URI=http://localhost:5173/bank/callback
