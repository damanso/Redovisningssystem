# Postgres — API:t ansluter som den lågprivilegierade rollen "app" (RLS tvingas).
DATABASE_URL=postgres://app@127.0.0.1:5433/redovisning
# Ägar-/adminanslutning som ENDAST används av migrationsrunnern.
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5433/redovisning

# KRÄVS, minst 32 tecken. Servern vägrar starta utan den — det finns ingen fallback.
# Generera: openssl rand -hex 32
JWT_SECRET=

PORT=3000
# Uppladdade filer lagras här (utanför webbroten), med UUID-namn. Relativt server/.
UPLOAD_DIR=data/uploads
